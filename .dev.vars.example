# Copy to `.dev.vars` (gitignored) for local Worker development. YOUTUBE_API_KEY
# is a Worker secret; keep it out of build-time variables and public JS.
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=UCtZlioPBBORWMMMSJ9BE1Wg

# Optional local override — widen the window so you can test without waiting
# for Saturday morning. `* * * * *` means "always open".
# LIVE_CHECK_CRON=* * * * *

# /api/contact sends through Brevo. These local values belong in the ignored
# `.dev.vars` file. Production and devtest keep their secrets on Cloudflare.
BREVO_API_KEY=
CONTACT_EMAIL_TO=
CONTACT_EMAIL_FROM=website@sdastruisbaai.co.za

# The fallback channel, used only when email is unconfigured or fails. Also a
# Worker secret in production. Point it at any local server that returns 200 to
# watch what the church's inbox would receive; leave every channel unset and the
# form reports `not-configured` instead of pretending.
CONTACT_WEBHOOK_URL=

# Bot protection for /api/contact (Cloudflare Turnstile, CONCERNS.md C-21).
# Create a widget in the Cloudflare dashboard (Turnstile) for sdastruisbaai.co.za.
# The secret lives here as a Worker secret in production (`wrangler secret put
# TURNSTILE_SECRET_KEY`); the site key is public and reaches the form as a
# build-time var instead: PUBLIC_TURNSTILE_SITE_KEY=<site key> in the build env.
# Leave both unset and the form submits exactly as before — the check runs only
# where the secret is set.
# TURNSTILE_SECRET_KEY=
# Where the widget is solved must match what siteverify echoes back. For
# `npm run worker:dev` on localhost, set this alongside the secret:
# TURNSTILE_HOSTNAMES=localhost
