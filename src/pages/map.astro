---
import '@cloudkid-labs/sda-church-site-core/styles.css';
import { ChurchMap } from '@cloudkid-labs/sda-church-site-core/react';
import { CHURCH_SITE } from '../data/churchSite';
import { SITE } from '../data/site';

const indexable = import.meta.env.PUBLIC_INDEXABLE !== 'false';
const canonical = new URL('/map/', Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{SITE.fullName} — Map</title>
    <link rel="canonical" href={canonical.href} />
    {!indexable && <meta name="robots" content="noindex,nofollow" />}
    <style is:global>
      html,
      body {
        margin: 0;
        padding: 0;
        height: 100%;
      }
      body {
        display: flex;
        flex-direction: column;
      }
      .map-page,
      .map-page .sda-map-shell {
        flex: 1 1 auto;
        width: 100%;
        height: auto;
        min-height: 0;
        border-radius: 0;
      }
      .map-page .leaflet-control-attribution {
        display: none;
      }
      .map-attribution {
        flex: none;
        margin: 0;
        padding: 4px 8px;
        color: #536578;
        font: 11px/1.5 Arial, sans-serif;
        text-align: right;
      }
      .map-attribution a {
        color: #0078a8;
        text-decoration: underline;
      }
    </style>
  </head>
  <body>
    <ChurchMap
      lat={CHURCH_SITE.location!.lat}
      lng={CHURCH_SITE.location!.lng}
      name={SITE.fullName}
      address={SITE.address}
      markerUrl={CHURCH_SITE.location!.markerUrl}
      className="map-page"
      client:load
    />
    <p class="map-attribution">Map data © <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener noreferrer">OpenStreetMap contributors</a> (ODbL).</p>
  </body>
</html>
