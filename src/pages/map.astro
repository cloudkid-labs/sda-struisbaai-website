---
import '@cloudkid-labs/sda-church-site-core/styles.css';
import { ChurchMap } from '@cloudkid-labs/sda-church-site-core/react';
import { CHURCH_SITE } from '../data/churchSite';
import { SITE } from '../data/site';

const indexable = import.meta.env.PUBLIC_INDEXABLE !== 'false';
const canonical = new URL('/map/', Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{SITE.fullName} — Map</title>
    <link rel="canonical" href={canonical.href} />
    {!indexable && <meta name="robots" content="noindex,nofollow" />}
    <style is:global>
      html,
      body {
        margin: 0;
        padding: 0;
        height: 100%;
      }
      .map-page,
      .map-page .sda-map-shell {
        width: 100%;
        height: 100%;
        min-height: 100%;
        border-radius: 0;
      }
    </style>
  </head>
  <body>
    <ChurchMap
      lat={CHURCH_SITE.location!.lat}
      lng={CHURCH_SITE.location!.lng}
      name={SITE.fullName}
      address={SITE.address}
      markerUrl={CHURCH_SITE.location!.markerUrl}
      className="map-page"
      client:load
    />
  </body>
</html>
