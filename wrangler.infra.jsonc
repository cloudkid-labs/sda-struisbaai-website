{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "struisbaai-infra-map",
  "main": "./infra-worker.js",
  "compatibility_date": "2025-01-09",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./infra-public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "env": {
    "devtest": {
      "name": "struisbaai-infra-map-devtest",
      "routes": [{ "pattern": "infra.struisbaai-sda.cloudkid.link", "custom_domain": true }]
    }
  },
  "observability": { "enabled": true }
}
